// Karta — Prisma Schema
// Multi-tenant commerce foundation for the AI commerce platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ───────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  inventoryMode String @default("unlimited") // unlimited | managed — Karta's own inventory policy
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
  connections   WooCommerceConnection[]
  whatsAppConnections WhatsAppConnection[]
  wooCustomerCarts    WooCustomerCart[]
  events              CustomerEvent[]

  @@map("tenants")
}

// ─── WooCommerceConnection ───────────────────────────────────
model WooCommerceConnection {
  id               String   @id @default(cuid())
  tenantId         String
  siteUrl          String
  siteName         String?
  connectionId     String   @unique
  connectionSecret String   // Per-connection secret for HMAC authentication
  status           String   @default("active") // active | disconnected
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("woocommerce_connections")
}

// ─── WebhookEvent ────────────────────────────────────────────
model WebhookEvent {
  id             String   @id @default(cuid())
  connectionId   String
  eventType      String // product.created | product.updated | product.deleted
  externalEventId String? // WooCommerce webhook event ID for deduplication
  payload        Json
  status         String   @default("pending") // pending | processed | failed
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([connectionId, externalEventId])
  @@index([connectionId])
  @@map("webhook_events")
}

// ─── WooCustomerCart ─────────────────────────────────────────
model WooCustomerCart {
  id         String   @id @default(cuid())
  tenantId   String
  phone      String   // WhatsApp phone number (E.164)
  cartToken  String   @unique // Opaque token identifying this customer's persistent cart
  items      Json     // [{ productId, variationId, quantity, name, price }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, phone])
  @@index([cartToken])
  @@map("woo_customer_carts")
}

// ─── WhatsAppConnection ──────────────────────────────────────
model WhatsAppConnection {
  id                String   @id @default(cuid())
  tenantId          String
  phoneNumberId     String   @unique
  businessAccountId String?
  displayPhoneNumber String?
  accessToken        String?  // Sensitive: server-side only, never exposed via API
  status            String   @default("active") // active | disconnected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("whatsapp_connections")
}

// ─── Product ─────────────────────────────────────────────────
model Product {
  id             String   @id @default(cuid())
  tenantId       String
  externalId     String?  // WooCommerce product ID
  sku            String?
  name           String
  slug           String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int?     // null = stock not managed (available), 0 = out of stock
  stockStatus    String?  // WooCommerce stock status: instock | outofstock | onbackorder
  manageStock    Boolean? // WooCommerce manage_stock (null = unknown/older payload)
  image          String?  // Primary image URL (from WooCommerce)
  images         Json?    // Additional image URLs (array of strings, from WooCommerce gallery)
  category       String?  // Product category name (from WooCommerce)
  productUrl     String?  // Canonical WooCommerce product permalink — never constructed manually
  wooConnectionId String?  // The Woo connection that synced this product (identity scope)
  status         String   @default("active") // active | draft | archived
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  variants  ProductVariant[]
  orderItems OrderItem[]

  // Identity: one product per (tenantId, wooConnectionId, externalId) —
  // enforced by the unique constraints below. Connection scoping is handled
  // in the sync layer (adoption/claiming) and this index makes the scoped
  // lookup fast. Slug is also scoped to the connection so two stores can
  // have products with the same slug without collision.
  @@unique([tenantId, wooConnectionId, slug])
  @@unique([tenantId, wooConnectionId, externalId])
  @@index([tenantId, wooConnectionId, externalId])
  @@index([tenantId])
  @@index([wooConnectionId])
  @@map("products")
}

// ─── ProductVariant ──────────────────────────────────────────
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  externalId String?  // WooCommerce variant ID
  sku        String?
  name       String
  attributes Json     // { "color": "Black", "size": "L" }
  price      Decimal  @db.Decimal(10, 2)
  stock      Int?     // null = stock not managed (available), 0 = out of stock
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product    @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@unique([productId, externalId])
  @@index([productId])
  @@map("product_variants")
}

// ─── Customer ────────────────────────────────────────────────
model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  name       String?
  phone      String?
  email      String?
  externalId String?  // WooCommerce customer ID
  visitorId  String?  // Linked first-party anonymous visitor identity (anonymous → Woo customer merge)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  orders        Order[]
  events        CustomerEvent[]

  @@unique([tenantId, externalId])
  @@unique([tenantId, visitorId])
  @@index([tenantId])
  @@map("customers")
}

// ─── CustomerEvent ───────────────────────────────────────────
model CustomerEvent {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String?
  visitorId  String?
  type       String   // CONVERSATION_STARTED | MESSAGE_SENT | PRODUCT_SEARCHED | PRODUCT_VIEWED | PRODUCT_CLICKED | PRODUCT_RECOMMENDED | PRODUCT_ADDED_TO_CART | PRODUCT_REMOVED_FROM_CART | CHECKOUT_STARTED | ORDER_COMPLETED | CATEGORY_VIEWED
  metadata   Json?    // Structured event metadata (query/category/budget/productId/etc.)
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, customerId])
  @@index([tenantId, visitorId])
  @@map("customer_events")
}

// ─── Conversation ────────────────────────────────────────────
model Conversation {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String?
  visitorId  String?  // First-party anonymous web visitor identity (per-visitor web conversations)
  channel    String   // "web" | "whatsapp"
  externalId String?  // WhatsApp conversation ID
  status     String   @default("active") // active | closed | archived
  metadata   Json?    // Website chat context: { selectedProductId, selectedVariantId, pendingCart, location }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  messages  Message[]

  @@unique([tenantId, externalId])
  @@index([tenantId, visitorId])
  @@index([tenantId])
  @@map("conversations")
}

// ─── Message ─────────────────────────────────────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String
  externalId     String?  // WhatsApp message ID
  role           String   // "customer" | "assistant" | "system"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

// ─── Order ───────────────────────────────────────────────────
model Order {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String?
  status     String   @default("pending") // pending | confirmed | shipped | delivered | cancelled
  subtotal   Decimal  @db.Decimal(10, 2)
  shipping   Decimal  @default(0) @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
  currency   String   @default("BDT")
  externalId String?  // WooCommerce order ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("orders")
}

// ─── OrderItem ───────────────────────────────────────────────
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order    Order           @relation(fields: [orderId], references: [id])
  product  Product?        @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
