# Karta Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose server-side secrets to browser code.

# ─── Application ─────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karta?schema=public"

# ─── AI Provider (Groq) ──────────────────────────────────────
GROQ_API_KEY=

# ─── WordPress Connector ─────────────────────────────────────
# Note: Per-connection secrets are generated server-side when creating
# a WooCommerce connection. This global secret is no longer used for
# WordPress authentication but is kept for backward compatibility.
WORDPRESS_CONNECT_SECRET=

# ─── WhatsApp ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_SECRET=

# ─── Security ────────────────────────────────────────────────
# Used for webhook verification and API authentication in later phases
INTERNAL_API_SECRET=
